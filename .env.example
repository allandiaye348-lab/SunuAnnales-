# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAASPAY SÉNÉGAL GATEWAY CONFIGURATION (Wave Sénégal & Orange Money)
# Never expose these keys to client-side code!
SAASPAY_API_KEY="sk_live_..."
SAASPAY_BASE_URL="https://api.saspay.me/api/v1"
SAASPAY_WEBHOOK_SECRET="your_saaspay_webhook_secret_here"
SAASPAY_ENV="production" # "test" or "production"

# WAVE PAYMENT CONFIGURATION
WAVE_API_KEY="your_wave_api_key_here"
WAVE_WEBHOOK_SECRET="your_wave_webhook_secret_here"

# ORANGE MONEY / CINETPAY / GLOBAL WEBHOOK SECURITY
PAYMENT_WEBHOOK_SECRET="sunu_webhook_secret_key_sn"
JWT_SECRET="sunuannales_secure_jwt_token_key"
ADMIN_PIN="2026"
